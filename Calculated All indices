import pandas as pd
import pubchempy as pcp
from rdkit import Chem
from rdkit.Chem import Descriptors, Crippen, rdMolDescriptors

# Excel file
input_file = "100_Drugs_13_Indices.xlsx"

# Read file
df = pd.read_excel(input_file)

# SMILES column name
smiles_col = "SMILES"

results = []

for i, row in df.iterrows():
    drug = row["Drug"]
    smiles = row[smiles_col]

    try:
        mol = Chem.MolFromSmiles(smiles)

        # RDKit Properties
        MW = Descriptors.MolWt(mol)
        LogP = Crippen.MolLogP(mol)
        tPSA = rdMolDescriptors.CalcTPSA(mol)
        Rot_Bonds = rdMolDescriptors.CalcNumRotatableBonds(mol)
        CMR = Crippen.MolMR(mol)

        # PubChem Properties
        compounds = pcp.get_compounds(smiles, 'smiles')

        PSA = None
        Polar = None
        Molar_Ref = None
        CLogP = None
        LogS = None

        if compounds:
            c = compounds[0]

            PSA = getattr(c, "tpsa", None)
            CLogP = getattr(c, "xlogp", None)

        results.append({
            "Drug": drug,
            "LogP": LogP,
            "PSA": PSA,
            "MW": MW,
            "Molar_Ref": CMR,
            "Rot_Bonds": Rot_Bonds,
            "Polar": Polar,
            "tPSA": tPSA,
            "CLogP": CLogP,
            "CMR": CMR,
            "LogS": LogS
        })

    except Exception as e:
        print(drug, e)

output = pd.DataFrame(results)

output.to_excel("Drug_Properties.xlsx", index=False)

